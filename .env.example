# Required: get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (defaults shown)
GROQ_MODEL=qwen/qwen3.8-27b
# Used automatically while GROQ_MODEL is rate-limited (separate per-model quota)
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# Empty = model default (recommended). "low" works for openai/gpt-oss-*. "none" disables
# Qwen thinking but makes it skip tools and hallucinate, so avoid it.
GROQ_REASONING_EFFORT=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_MODEL_HI=whisper-large-v3
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_TOOL_ITERATIONS=5
MAX_HISTORY_TURNS=8
# Force a tool call (e.g. knowledge base) before every answer
REQUIRE_TOOL_FIRST=true
RAG_TOP_K=4
RECORD_SAMPLE_RATE=16000
LOG_LEVEL=INFO

# Web UI (python -m web.app)
HOST=127.0.0.1
PORT=8000
# If set, the page asks for this code before starting a call (protects your Groq quota)
ACCESS_CODE=
